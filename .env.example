# 웹 화면 로그인 비밀번호
APP_PASSWORD=change-me
# 세션 쿠키 서명용 임의 문자열 (길게)
SECRET_KEY=replace-with-a-long-random-string
# 메일 버튼 링크에 쓰일 주소 (휴대폰에서 누르려면 외부에서 접속 가능한 주소여야 함)
BASE_URL=http://localhost:8000

# 메일 발송 방식: smtp(실제 Gmail 발송) | console(outbox/ 폴더에 HTML 저장)
MAIL_BACKEND=console
GMAIL_ADDRESS=you@gmail.com
# Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호 (16자리)
GMAIL_APP_PASSWORD=

# SQLite 파일 경로
DATABASE_URL=sqlite:///./data/app.db
TIMEZONE=Asia/Seoul
# 스케줄러 사용 여부 (테스트 시 false)
SCHEDULER_ENABLED=true
