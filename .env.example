# 로컬 실행용 환경 변수 예시. 복사해서 .env 로 쓰세요: cp .env.example .env
# (Codespaces 는 GitHub Codespaces Secrets, Render 는 대시보드 Environment 에 넣습니다)

# 세션 쿠키 서명용 임의 문자열 (운영에서는 반드시 길고 무작위로)
SECRET_KEY=replace-with-a-long-random-string
# 앱 주소. 비워 두면 Codespaces/Render 주소를 자동으로 씀. 로컬은 http://localhost:8000
BASE_URL=

# ---- 로그인
# 개발용 이메일 로그인 (로컬·Codespaces 전용. Render 에서는 켜면 서버가 시작을 거부)
DEV_LOGIN=true
# 구글 로그인 (Google Cloud Console → OAuth 클라이언트). 리디렉션 URI: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 관리자 이메일: 기존 단일 사용자 데이터를 넘겨받고, DB 백업을 내려받을 수 있음
ADMIN_EMAIL=
# 가입 허용 목록 (쉼표 구분). 비워 두면 누구나 가입
ALLOWED_EMAILS=

# ---- 알림
# 서버에서 켤 알림 수단: push, email (둘 다면 push,email)
NOTIFY_CHANNELS=push,email
# 웹 푸시 VAPID 키: python -m scripts.gen_vapid mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# 메일 발송: smtp(실제 Gmail 발송) | console(outbox/ 에 저장하고 앱에서 미리보기)
MAIL_BACKEND=console
GMAIL_ADDRESS=
# Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호 (16자리)
GMAIL_APP_PASSWORD=

# ---- 기타
DATABASE_URL=sqlite:///./data/app.db
TIMEZONE=Asia/Seoul
SCHEDULER_ENABLED=true
